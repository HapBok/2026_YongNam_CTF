{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "challenge_id": {
      "type": "string",
      "maxLength": 4096
    },
    "task_id": {
      "type": "string",
      "maxLength": 4096
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "stage_status": {
      "type": "string",
      "enum": [
        "partial",
        "candidate",
        "verified",
        "blocked",
        "error"
      ]
    },
    "classification": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "web",
            "pwn",
            "rev",
            "crypto",
            "forensics",
            "mobile",
            "ai",
            "misc",
            "malware",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "category",
        "confidence"
      ],
      "additionalProperties": false
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 4096
          },
          "evidence_path": {
            "type": "string",
            "maxLength": 4096
          },
          "repro_command": {
            "type": "string",
            "maxLength": 4096
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "claim",
          "evidence_path",
          "repro_command",
          "confidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 64
    },
    "discarded_hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 64
    },
    "evidence_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 4096
          },
          "evidence_path": {
            "type": "string",
            "maxLength": 4096
          },
          "repro_command": {
            "type": "string",
            "maxLength": 4096
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "claim",
          "evidence_path",
          "repro_command",
          "confidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "kind": {
            "type": "string",
            "enum": [
              "solution",
              "evidence"
            ]
          },
          "sha256": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "reproduction_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 64
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 64
    },
    "next_action": {
      "type": "string",
      "maxLength": 4096
    },
    "recommended_next_profile": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "candidate_flag_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "challenge_id",
    "task_id",
    "generation",
    "stage_status",
    "classification",
    "verified_facts",
    "hypotheses",
    "discarded_hypotheses",
    "evidence_delta",
    "artifacts",
    "reproduction_steps",
    "blockers",
    "next_action",
    "recommended_next_profile",
    "candidate_flag_ref"
  ],
  "additionalProperties": false
}
